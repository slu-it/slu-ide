      "tokenModifiers": [
        "declaration",
        "definition",
        "readonly",
        "static",
        "deprecated",
        "abstract",
        "async",
        "modification",
        "documentation",
        "defaultLibrary"
      ],
      "formats": [
        "relative"
      ],
      "overlappingTokenSupport": false,
      "multilineTokenSupport": false,
      "dynamicRegistration": false
    },
    "diagnostic": {
      "relatedDocumentSupport": false,
      "dynamicRegistration": true
    }
  },
  "window": {
    "workDoneProgress": true
  },
  "general": {
    "positionEncodings": [
      "utf-16"
    ]
  }
