    "workspaceFolders": true,
    "configuration": true,
    "semanticTokens": {
      "refreshSupport": true
    },
    "inlayHint": {
      "refreshSupport": true
    },
    "diagnostics": {
      "refreshSupport": true
    }
  },
  "textDocument": {
